# Copy to .env. Keep .env private and out of Git.
DATABASE_URL=postgresql://user:password@tls-enabled-host:5432/database?sslmode=require
AI_LOGGER_ADMIN_TOKEN=replace-with-a-long-random-secret
AI_LOGGER_SERVER_HOST=0.0.0.0
AI_LOGGER_SERVER_PORT=8765
AI_LOGGER_PUBLISH_PORT=8765
AI_LOGGER_SERVER_PROJECT_DAILY_DIR=/app/logs
AI_LOGGER_WEB_LOGS_ROOT=/app/logs
